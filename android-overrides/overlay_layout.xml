<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/background_shape">

    <!-- ⚡ شريط آخر الأوراق -->
    <TextView
        android:id="@+id/droppedView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="📌 لا توجد"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:background="#22000000"
        android:layout_marginBottom="4dp" />

    <!-- ⚡ الشبكة — الصف الأول -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="1"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="2"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="3"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="4"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- ⚡ الصف الثاني -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="5"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="6"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="7"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn10"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="10"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- ⚡ الصف الثالث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn11"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="11"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn12"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="12"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <!-- فراغ -->
        <View
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp" />

        <!-- زر تراجع -->
        <Button
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="↩"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- ⚡ الفوتر — العداد + تحديث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/counterView"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="40"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:background="#AA000000"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="🔄 تحديث"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_shape"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

</LinearLayout>